 cp(45,120,124,140)
 cp(46, 72, 76, 96)
 cp(47,196,110, 96)
 -- neve (48..63)
 cp(48, 10, 18, 42)
 cp(49, 18, 32, 64)
 cp(50, 32, 56, 92)
 cp(51, 64, 96,128)
 cp(52,120,156,180)
 cp(53,255,250,235)
 cp(54, 48, 70,104)
 cp(55, 36, 54, 84)
 cp(56,140,170,200)
 cp(57,250,252,255)
 cp(58,200,220,240)
