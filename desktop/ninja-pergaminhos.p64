 cp(63,255,180,120)
end

function usetarget(ud)
 set_draw_target(ud)
 clip()
 camera()
 fillp()
end

function clear_target(ud,col)
 usetarget(ud)
 cls(col or 0)
end

function dither(x0,y0,x1,y1,c,par)
 for y=y0,y1 do
  for x=x0,x1 do
   if ((x+y+(par or 0))%2)==0 then pset(x,y,c) end
  end
 end
end

function dither_band(y0,y1,c0,c1,seed)
 for y=y0,y1 do
  local t=(y-y0)/(y1-y0+1)
  for x=0,SW-1 do
   if rnd(1)<t then pset(x,y,c1) else pset(x,y,c0) end
  end
 end
end

function ptext(s,x,y,c)
 print(s,x+1,y+1,0)
 print(s,x,y,c)
end

function ctext(s,y,c)
 local x=flr((SW-#s*5)/2)
 ptext(s,x,y,c)
end

-- fonte 4x7 da RAM (0x4000), ampliada
function bigtext(s,x,y,sc,c)
 for i=1,#s do
  local ch=ord(s,i)
  local gx=x+(i-1)*6*sc
  for row=0,6 do
   local b=peek(0x4000+ch*8+row)
   if b~=0 then
    for col=0,4 do
     if (b&(1<<col))~=0 then
      rectfill(gx+col*sc,y+row*sc,gx+col*sc+sc-1,y+row*sc+sc-1,c)
     end
    end
   end
  end
 end
end

function bigtext_shadow(s,x,y,sc,c)
 bigtext(s,x+3,y+3,sc,0)
 bigtext(s,x,y,sc,c)
end

-- fonte compacta (0x5600), a mesma do print
function smalltext(s,x,y,sc,c)
 for i=1,#s do
  local ch=ord(s,i)
  local gx=x+(i-1)*5*sc
  for row=0,7 do
   local b=peek(0x5600+ch*8+row)
   if b~=0 then
    for col=0,2 do
     if (b&(1<<col))~=0 then
      rectfill(gx+col*sc,y+row*sc,gx+col*sc+sc-1,y+row*sc+sc-1,c)
     end
    end
   end
  end
 end
end

function smalltext_shadow(s,x,y,sc,c)
 smalltext(s,x+2,y+2,sc,0)
 smalltext(s,x,y,sc,c)
end

-- ============================================================
-- trilha do mapa (polilinha com distancia acumulada)
-- ============================================================
MAPPATH={
 {x=48,y=214},{x=120,y=214},{x=170,y=206},{x=230,y=198},
 {x=300,y=192}, -- no 1
 {x=380,y=192},{x=450,y=200},{x=520,y=206},{x=600,y=200},
 {x=670,y=186},{x=740,y=170},{x=820,y=154},{x=880,y=146}, -- no 2
}
MAPSEG={}
MAPD={}
MAPNODES={}
MAPPATHY={}
MAPLEN=0

function build_mappath()
 MAPSEG={}
 MAPD={0}
 MAPLEN=0
 for i=1,#MAPPATH-1 do
  local a,b=MAPPATH[i],MAPPATH[i+1]
  local dx,dy=b.x-a.x,b.y-a.y
  local len=sqrt(dx*dx+dy*dy)
  MAPSEG[i]={x=a.x,y=a.y,dx=dx,dy=dy,len=len,d=MAPLEN}
  MAPLEN+=len
  MAPD[i+1]=MAPLEN
 end
 MAPNODES={
  {id=1,x=MAPPATH[5].x,y=MAPPATH[5].y,d=MAPD[5]},
  {id=2,x=MAPPATH[13].x,y=MAPPATH[13].y,d=MAPD[13]},
 }
 MAPPATHY={}
 for x=0,MAPW-1 do MAPPATHY[x]=path_y_at_x(x) end
end

function map_path_at(d)
 d=mid(0,d,MAPLEN)
 for i=1,#MAPSEG do
  local s=MAPSEG[i]
  if d<=s.d+s.len or i==#MAPSEG then
   local t=(d-s.d)/s.len
   return s.x+s.dx*t,s.y+s.dy*t
  end
 end
 return MAPPATH[1].x,MAPPATH[1].y
end

function path_y_at_x(x)
 local a=MAPPATH[1]
 if x<=a.x then return a.y end
 local b=MAPPATH[#MAPPATH]
 if x>=b.x then return b.y end
 for i=1,#MAPSEG do
  local s=MAPSEG[i]
  if x>=s.x and x<=s.x+s.dx then
   return s.y+s.dy*((x-s.x)/s.dx)
  end
 end
 return b.y
end

function copy_scrolls(src)
 local t={}
 for s in all(src) do t[#t+1]={x=s.x,y=s.y,id=s.id,got=false} end
 return t
end

function copy_enemies(src)
 local t={}
 for e in all(src) do
  t[#t+1]={x=e.x,y=e.y,x1=e.x1,x2=e.x2,dir=e.dir,spd=e.spd,anim=0,dead=false}
 end
 return t
end

-- ============================================================
-- audio: banco de instrumentos gerado na RAM do PFX6416
-- (sem sfx/0.sfx: o cartucho e autossuficiente)
-- layout: indice 0x30000, instrumentos 0x40000, wavetable 0x50000
-- ============================================================
WAVE_BASE=0x50000
WAVE_ADDR=WAVE_BASE/256
NOISE_ADDR=(WAVE_BASE+4*2048)/256

function put16(addr,v)
 if v<0 then v=v+65536 end
 poke(addr,v%256)
 poke(addr+1,flr(v/256)%256)
end

function gen_wave(entry,kind)
 local base=WAVE_BASE+entry*2048
 for i=0,1023 do
  local t=i/1024
  local s
  if kind==0 then s=math.sin(t*2*math.pi)
  elseif kind==1 then s=1-4*math.abs(t-0.5)
  elseif kind==2 then s=2*t-1
  else s=(t<0.5) and 1 or -1 end
  put16(base+i*2,flr(s*28000))
 end
end

function gen_noise()
 local seed=22222
 for i=0,1023 do
  seed=(seed*16807)%2147483647
  put16(WAVE_BASE+4*2048+i*2,(seed%60001)-30000)
 end
end

function aud_pval(addr,flags,v0,v1)
 poke(addr,flags)
 poke(addr+1,v0)
 poke(addr+2,v1)
 poke(addr+3,0)
end

function aud_node(base,kind,kindp)
 poke(base,0)
 poke(base+1,kind+(kindp<<4))
 poke(base+2,0)
 poke(base+3,0)
end

-- n: instrumento / wave: 0 sine, 64 tri, 128 saw, 192 square
-- wtaddr / wth: wavetable (endereco em blocos de 256 bytes, altura)
function mk_inst(n,wave,wtaddr,wth,vol)
 local b=0x40000+n*512
 for i=0,511 do poke(b+i,0) end
 aud_node(b,1,0)               -- mixer raiz
 aud_pval(b+4,0,64,64)         -- volume cheio, sem envelope
 aud_pval(b+8,1,0,0)
 aud_pval(b+12,1,0,0)
 aud_pval(b+16,1,0,0)
 aud_node(b+32,2,0)            -- OSC, wavetable 0
 aud_pval(b+36,2,vol or 32,vol or 32)
 aud_pval(b+40,1,0,0)          -- pan centro
 aud_pval(b+44,0x21,0,0)       -- tune
 aud_pval(b+48,1,0,0)          -- bend
 aud_pval(b+52,0,wave,0)       -- wave
 aud_pval(b+56,0,0,0)          -- phase
 aud_pval(b+60,0,0,0)
 poke(b+480,wtaddr%256)
 poke(b+481,flr(wtaddr/256)%256)
 poke(b+482,10)                -- 1024 amostras por onda
 poke(b+483,wth)
end

function init_audio()
 gen_wave(0,0) gen_wave(1,1) gen_wave(2,2) gen_wave(3,3) gen_noise()
 -- indice
 for i=0,31 do poke(0x30000+i,0) end
 poke2(0x30000,5)              -- 5 instrumentos
 poke2(0x30002,0)
 poke2(0x30004,0)
 poke2(0x30006,0)
 poke4(0x30008,0x10000)        -- instrumentos em 0x40000
 poke4(0x3000c,0)
 poke4(0x30010,0)
 poke4(0x30014,0)
 poke2(0x30018,5880)
 poke2(0x3001a,64)
 poke(0x3001c,6)
 mk_inst(0,0,WAVE_ADDR,4,32)    -- sine
 mk_inst(1,64,WAVE_ADDR,4,32)   -- triangle
 mk_inst(2,128,WAVE_ADDR,4,32)  -- saw
 mk_inst(3,192,WAVE_ADDR,4,32)  -- square
 mk_inst(4,0,NOISE_ADDR,1,32)   -- noise
end

SND={
 jump={{3,57,42,3},{2,62,36,3},{2,67,28,3},{2,72,20,3}},
 djump={{2,64,42,1},{2,69,36,1},{2,74,30,1},{3,79,22,1}},
 shuri={{1,84,26,3},{1,79,22,3},{1,74,18,3},{2,69,12,3}},
 kill={{2,40,30,4},{2,33,24,4},{3,26,16,4}},
 dash={{1,50,34,2},{1,57,28,2},{2,64,22,2},{2,71,16,2}},
 scroll={{3,60,30,0},{3,64,30,0},{3,67,28,0},{3,72,26,0},{4,76,24,0},{4,79,20,0}},
 hurt={{2,55,40,2},{2,48,32,2},{2,41,24,2},{3,34,14,2}},
 check={{4,72,30,0},{6,79,22,0},{4,84,18,0}},
 win={{6,60,32,1},{6,64,32,1},{6,67,30,1},{6,72,28,1},{8,76,26,3},{8,79,24,3},{12,84,20,3}},
 over={{6,48,30,2},{6,43,26,2},{6,36,22,2},{6,31,18,2},{12,24,12,2}},
 start={{3,67,30,1},{3,72,26,1},{6,79,20,3}},
 enter={{2,67,30,1},{2,72,25,1},{4,79,20,1}},
 deny={{3,45,28,2},{3,39,20,2}},
}

MEL={69,0,72,0,76,0,72,0, 69,0,67,0,64,0,67,0,
     72,0,76,0,79,0,76,0, 74,0,71,0,67,0,71,0}
BASS={45,41,48,43}

function playsfx(name)
 local src=SND[name]
 if not src or muted then return end
 -- copia + passo final de volume zero (evita clique no corte)
 local d={}
 for i=1,#src do d[i]=src[i] end
 local last=src[#src]
 d[#d+1]={1,last[2],0,last[4] or 0}
 local ch=voiceseq
 voiceseq=voiceseq%4+1
 voices[ch]={d=d,i=1,t=d[1][1]}
 note(d[1][2],d[1][4] or 0,d[1][3],0,0,ch,true)
end

function update_sfx()
 for ch,v in pairs(voices) do
  v.t-=1
  if v.t<=0 then
   v.i+=1
   local st=v.d[v.i]
   if st then
    v.t=st[1]
    note(st[2],st[4] or 0,st[3],0,0,ch,true)
   else
    voices[ch]=nil
    sfx(-2,ch)
   end
  end
 end
end

function stop_music()
 music_on=false
 sfx(-2,6)
 sfx(-2,7)
end

function update_music()
 if not music_on or muted then return end
 mtick+=1
 if mtick<mtempo then return end
 mtick=0
 mstep=mstep%32+1
 local m=MEL[mstep]
 if m and m>0 then note(m,1,13,0,0,6,true) end
 if (mstep-1)%8==0 then
  local b=BASS[flr((mstep-1)/8)+1]
  note(b,0,17,0,0,7,true)
 end
end

-- ============================================================
-- entrada (sem auto-repeat: um toque = uma acao)
-- ============================================================
function down(b) return btn(b) and true or false end
function pressed(b) return down(b) and not prevbtn[b] end

function input_end()
 for b=0,7 do prevbtn[b]=down(b) end
 local km=key("m") and true or false
 if km and not prevkey then
  muted=not muted
  poke(0x5538,muted and 0 or 0x40)
  poke(0x5539,muted and 0 or 0x40)
 end
 prevkey=km
end

-- ============================================================
-- mapa e colisao
-- ============================================================
function tileat_map(map,tx,ty)
 if ty<0 or ty>=MH or tx<0 or tx>=MW then return "." end
 return sub(map[ty+1],tx+1,tx+1)
end

function solid_at_map(map,tx,ty)
 if tx<0 or tx>=MW then return true end
 if ty<0 then return true end
 if ty>=MH then return false end
 local c=tileat_map(map,tx,ty)
 return c=="#" or c=="%" or c=="="
end

function tileat(tx,ty)
 return tileat_map(curmap,tx,ty)
end

function solid_at(tx,ty)
 return solid_at_map(curmap,tx,ty)
end

function hit(x,y,w,h)
 for ty=flr(y/TW),flr((y+h-0.01)/TW) do
  for tx=flr(x/TW),flr((x+w-0.01)/TW) do
   if solid_at(tx,ty) then return true end
  end
 end
 return false
end

-- ============================================================
-- arte pre-renderizada
-- ============================================================
function build_sky()
 local ud=userdata("u8",SW,SH)
 usetarget(ud)
 -- bandas de gradiente (transicoes curtas com dither)
 local bands={
  {0,44,C.sky0},
  {44,92,C.sky1},
  {92,138,C.sky2},
  {138,182,C.sky3},
  {182,SH,C.sky4},
 }
 for b in all(bands) do rectfill(0,b[1],SW-1,b[2]-1,b[3]) end
 for i=1,#bands-1 do
  local y=bands[i][2]
  dither_band(y-4,y-1,bands[i][3],bands[i+1][3])
 end
 -- estrelas
 srand(31)
 for i=1,130 do
  local x=flr(rnd(SW))
  local y=flr(rnd(172))
  local dx=x-388
  local dy=y-62
  if dx*dx+dy*dy>50*50 then
   local r=rnd(1)
   local c=6
   if r<0.4 then c=33 elseif r<0.68 then c=6 elseif r<0.9 then c=15 else c=7 end
   pset(x,y,c)
   if c==7 and rnd(1)<0.35 then
    pset(x+1,y,6) pset(x,y+1,6)
   end
   if rnd(1)<0.18 then pset(x+1,y+1,c) end
  end
 end
 -- lua com halo granulado
 local mx,my,mr=388,62,24
 srand(88)
 for i=1,1100 do
  local a=rnd(1)
  local rr=mr+2+rnd(1)*30
  local x=flr(mx+cos(a)*rr)
  local y=flr(my+sin(a)*rr)
  if rnd(1)<(1-(rr-mr)/32)*0.7 then
   pset(x,y,(i%4==0) and C.sky3 or C.sky4)
  end
 end
 circfill(mx,my,mr,C.moon)
 -- sombra suave na borda inferior
 for i=0,40 do
  local a=i/40
  local x=flr(mx+cos(a)*mr)
  local y=flr(my+sin(a)*mr)
  pset(x,y,C.sky4)
 end
 -- crateras
 dither(mx-15,my+5,mx-6,my+13,6,0)
 dither(mx+3,my-12,mx+11,my-5,6,1)
 dither(mx+7,my+8,mx+14,my+14,C.sky4,0)
 dither(mx-4,my-17,mx+3,my-11,C.sky3,1)
 -- finas nuvens altas
 srand(12)
 for i=1,3 do
  local y=118+i*12+flr(rnd(6))
  local x=flr(rnd(SW))
  local w=50+flr(rnd(90))
  dither(x,y,x+w,y+2,C.sky3,0)
  pset(x+4,y+3,C.sky2)
 end
 usetarget(nil)
 return ud
end

function pagoda(x,base,h,col,rim)
 local tiers=4
 for i=0,tiers-1 do
  local yy=base-flr(i*h/tiers)
  local w=14-i*3
  -- beiral
  line(x-w,yy,x+w,yy,rim)
  line(x-w+2,yy+1,x+w-2,yy+1,col)
  line(x-w+3,yy+2,x+w-3,yy+2,col)
  pset(x-w-1,yy-1,rim) pset(x+w+1,yy-1,rim)
  -- corpo
  rectfill(x-3,yy-7,x+3,yy-1,col)
  line(x-3,yy-7,x+3,yy-7,rim)
  pset(x-3,yy-4,rim) pset(x+3,yy-4,rim)
 end
 -- pinaculo
 line(x,base-h,x,base-h-7,rim)
 pset(x,base-h-8,rim)
 pset(x-1,base-h-6,rim) pset(x+1,base-h-6,rim)
end

function build_far()
 local w,h=720,170
 local ud=userdata("u8",w,h)
 usetarget(ud)
 cls(0)
 srand(101)
 local function ry(x) return flr(96+sin(x/230)*20+sin(x/83+0.4)*9+sin(x/31+1.1)*4) end
 for x=0,w-1 do
  local y=ry(x)
  line(x,y,x,h-1,C.far)
  pset(x,y,C.sky3)
  if (x+y)%3==0 then pset(x,y+1,C.sky3) end
 end
 pagoda(160,ry(160),46,C.far,C.sky3)
 pagoda(552,ry(552),38,C.far,C.sky3)
 for i=1,40 do
  local x=flr(rnd(w))
  local y=ry(x)
  if rnd(1)<0.5 then pset(x,y+4+flr(rnd(20)),C.sky3) end
 end
 usetarget(nil)
 return ud
end

function build_near()
 local w,h=720,130
 local ud=userdata("u8",w,h)
 usetarget(ud)
 cls(0)
 srand(202)
 for x=0,w-1 do
  local y=flr(66+sin(x/150+0.8)*18+sin(x/57+2.2)*8+sin(x/23+0.2)*3)
  line(x,y,x,h-1,C.near)
  pset(x,y,C.far)
 end
 -- bambuzais silhueta
 for i=1,26 do
  local x=flr(rnd(w))
  local y=flr(66+sin(x/150+0.8)*18+sin(x/57+2.2)*8+sin(x/23+0.2)*3)
  local n=3+flr(rnd(3))
  for j=1,n do
   local bx=x+flr(rnd(10))-5
   local hh=12+flr(rnd(26))
   line(bx,y-hh,bx,y+2,C.near)
   pset(bx,y-hh,C.bamboo2)
   for k=1,3 do
    local ny=y-flr(k*hh/4)
    line(bx-2,ny,bx+2,ny,C.bamboo2)
   end
   line(bx,y-hh,bx+4,y-hh-2,C.bamboo2)
   line(bx,y-hh+2,bx-4,y-hh-2,C.bamboo2)
  end
 end
 usetarget(nil)
 return ud
end

function build_cloud()
 local ud=userdata("u8",72,22)
 usetarget(ud)
 cls(0)
 srand(5)
 for i=0,5 do
  local x=6+i*10+flr(rnd(6))
  local y=12+flr(rnd(4))-i%2*3
  local r=4+flr(rnd(5))
  circfill(x,y,r,C.sky2)
  circfill(x-2,y-2,r-2,C.sky3)
 end
 dither(2,15,69,20,C.mist,0)
 usetarget(nil)
 return ud
end

-- ---------- ceu e parallax de neve ----------
function build_snow_sky()
 local ud=userdata("u8",SW,SH)
 usetarget(ud)
 local bands={
  {0,50,SNOW.sky0},{50,105,SNOW.sky1},{105,155,SNOW.sky2},
  {155,205,SNOW.sky3},{205,SH,SNOW.sky4},
 }
 for b in all(bands) do rectfill(0,b[1],SW-1,b[2]-1,b[3]) end
 for i=1,#bands-1 do
  local y=bands[i][2]
  dither_band(y-4,y-1,bands[i][3],bands[i+1][3])
 end
 -- aurora
 for k=0,2 do
  for x=0,SW-1 do
   local y=30+k*20+flr(sin(x/70+k)*9+sin(x/23+k*2)*3)
   pset(x,y,SNOW.ice)
   if (x+k)%3==0 then pset(x,y+1,SNOW.ice2) end
  end
 end
 -- estrelas
 srand(41)
 for i=1,95 do
  local x=flr(rnd(SW))
  local y=flr(rnd(150))
  if rnd(1)<0.7 then pset(x,y,7) else pset(x,y,SNOW.snow) end
 end
 -- lua baixa com halo
 local mx,my,mr=388,66,22
 srand(99)
 for i=1,760 do
  local a=rnd(1)
  local rr=mr+2+rnd(1)*26
  local x=flr(mx+cos(a)*rr)
  local y=flr(my+sin(a)*rr)
  if rnd(1)<(1-(rr-mr)/30)*0.6 then
   pset(x,y,(i%3==0) and SNOW.ice or SNOW.mist)
  end
 end
 circfill(mx,my,mr,SNOW.sun)
 dither(mx-14,my+4,mx-6,my+12,SNOW.snow2,0)
 dither(mx+3,my-11,mx+10,my-4,SNOW.snow2,1)
 -- nuvens finas
 srand(17)
 for i=1,4 do
  local y=112+i*14+flr(rnd(6))
  local x=flr(rnd(SW))
  local w=60+flr(rnd(90))
  dither(x,y,x+w,y+2,SNOW.mist,0)
  pset(x+4,y+3,SNOW.snow2)
 end
 usetarget(nil)
 return ud
end

function build_snow_far()
 local w,h=720,170
 local ud=userdata("u8",w,h)
 usetarget(ud)
 cls(0)
 srand(303)
 local function ry(x) return flr(104+sin(x/210)*22+sin(x/79+0.7)*8+sin(x/29+1.3)*3) end
 for x=0,w-1 do
  local y=ry(x)
  line(x,y,x,h-1,SNOW.far)
  pset(x,y,SNOW.snow2)
  if (x+y)%4==0 then pset(x,y+1,SNOW.mist) end
  if y<96 then pset(x,y+2,SNOW.snow) end
 end
 -- picos recortados
 for i=1,7 do
  local px=40+i*92+flr(rnd(30))
  local ph=38+flr(rnd(46))
  local base=ry(px)
  for y=base-ph,base do
   local ww=flr((y-(base-ph))*0.7)
   line(px-ww,y,px+ww,y,SNOW.far)
  end
  for y=base-ph,base-ph+18 do
   local ww=flr((y-(base-ph))*0.7)
   line(px-ww,y,px+ww,y,SNOW.snow)
  end
 end
 usetarget(nil)
 return ud
end

function build_snow_near()
 local w,h=720,130
 local ud=userdata("u8",w,h)
 usetarget(ud)
 cls(0)
 srand(404)
 local function ry(x) return flr(74+sin(x/160+0.4)*16+sin(x/61+2)*7+sin(x/27+0.8)*3) end
 for x=0,w-1 do
  local y=ry(x)
  line(x,y,x,h-1,SNOW.near)
  pset(x,y,SNOW.far)
  if y<62 then pset(x,y+1,SNOW.snow2) end
 end
 for i=1,24 do
  local x=flr(rnd(w))
  local y=ry(x)
  draw_pine(x,y+2,500+i*13,true)
 end
 usetarget(nil)
 return ud
end

function build_snow_cloud()
 local ud=userdata("u8",72,22)
 usetarget(ud)
 cls(0)
 srand(6)
 for i=0,5 do
  local x=6+i*10+flr(rnd(6))
  local y=12+flr(rnd(4))-i%2*3
  local r=4+flr(rnd(5))
  circfill(x,y,r,SNOW.mist)
  circfill(x-2,y-2,r-2,SNOW.snow2)
 end
 dither(2,15,69,20,SNOW.snow2,0)
 usetarget(nil)
 return ud
end

-- ---------- tiles ----------
function draw_earth(x,y,tx,ty,map,th)
 srand(tx*97+ty*13+3)
 local top=not solid_at_map(map,tx,ty-1)
 rectfill(x,y,x+15,y+15,th.earth)
 if top then
  local gc=(rnd(1)<0.35) and th.grass2 or th.grass
  if th.snow then
   rectfill(x,y,x+15,y+4,gc)
   rectfill(x,y+5,x+15,y+5,th.grass2)
   -- acumulos de neve
   for i=0,15 do
    if ((i*5+tx*3)%7)<3 then pset(x+i,y+6,th.grass) end
   end
   for i=0,5 do
    local bx=x+flr(rnd(16))
    local by=y+1+flr(rnd(4))
    line(bx,by,bx+2,by,th.grass)
   end
   if rnd(1)<0.4 then
    local px=x+2+flr(rnd(12))
    pset(px,y+7,SNOW.ice)
    pset(px,y+8,SNOW.ice2)
   end
  else
   rectfill(x,y,x+15,y+2,gc)
   rectfill(x,y+3,x+15,y+3,th.grass2)
   for i=0,15 do
    if ((i*7+tx*5)%6)<2 then pset(x+i,y+4,th.grass2) end
   end
   for i=0,5 do
    local bx=x+flr(rnd(16))
    line(bx,y-1-flr(rnd(2)),bx,y,th.grass)
    if rnd(1)<0.4 then pset(bx+1,y-1,th.grass2) end
   end
  end
 else
  rectfill(x,y,x+15,y+15,th.earth)
  if th.snow then
   for i=1,6 do
    local px=x+flr(rnd(16))
    local py=y+2+flr(rnd(12))
    if rnd(1)<0.5 then pset(px,py,SNOW.snow2) end
   end
  end
 end
 for i=1,7 do
  local px=x+flr(rnd(16))
  local py=y+(top and (th.snow and 8 or 6) or 1)+flr(rnd(10))
  pset(px,py,th.earth2)
  if rnd(1)<0.3 then pset(px+1,py,th.earth2) end
 end
 if rnd(1)<0.45 then
  local px=x+2+flr(rnd(11))
  local py=y+7+flr(rnd(7))
  rectfill(px,py,px+1,py+1,th.rock2)
 end
 if not solid_at_map(map,tx-1,ty) then rectfill(x,y,x+1,y+15,th.side) end
 if not solid_at_map(map,tx+1,ty) then rectfill(x+14,y,x+15,y+15,th.side) end
end

function draw_rock(x,y,tx,ty,map,th)
 srand(tx*61+ty*29+7)
 rectfill(x,y,x+15,y+15,th.rock)
 for i=0,3 do
  local px=x+flr(rnd(13))
  local py=y+flr(rnd(13))
  local w=2+flr(rnd(3))
  rectfill(px,py,px+w,py+1,th.rock2)
  pset(px,py,th.rock_hi)
 end
 if rnd(1)<0.5 then
  local px=x+flr(rnd(12))
  line(px,y+2,px+2,y+8,th.earth2)
  pset(px+1,y+9,th.earth2)
 end
 if not solid_at_map(map,tx,ty-1) then
  line(x,y,x+15,y,th.rock_hi)
  pset(x,y,th.grass2)
  if th.snow then
   rectfill(x,y,x+15,y+1,th.grass)
   for i=0,15 do
    if ((i*3+tx)%5)<2 then pset(x+i,y+2,th.grass) end
   end
   if rnd(1)<0.5 then
    local px=x+2+flr(rnd(12))
    pset(px,y+3,SNOW.snow)
   end
  end
 end
 if not solid_at_map(map,tx-1,ty) then rectfill(x,y,x+1,y+15,th.earth2) end
 if not solid_at_map(map,tx+1,ty) then rectfill(x+14,y,x+15,y+15,th.earth2) end
end

function draw_plank(x,y,tx,ty,map,th)
 local left=tileat_map(map,tx-1,ty)~="="
 local right=tileat_map(map,tx+1,ty)~="="
 rectfill(x,y+3,x+15,y+11,th.plank)
 rectfill(x,y+3,x+15,y+4,th.plank_top)
 line(x,y,x+15,y,th.plank_hi)
 line(x,y+1,x+15,y+1,th.plank_top)
 rectfill(x,y+9,x+15,y+11,th.earth2)
 line(x,y+12,x+15,y+12,th.side)
 if th.snow then
  -- facetas de gelo
  line(x+3,y+5,x+7,y+8,th.plank_hi)
  line(x+9,y+5,x+13,y+9,th.plank_hi)
  pset(x+2,y+6,SNOW.snow)
  pset(x+12,y+7,SNOW.snow)
  pset(x+6,y+9,SNOW.ice)
 else
  -- veios de madeira
  line(x+5,y+5,x+5,y+8,th.earth2)
  line(x+11,y+5,x+11,y+8,th.earth2)
  pset(x+2,y+6,25)
  pset(x+9,y+7,25)
 end
 if left then rectfill(x,y,x+1,y+11,th.side) end
 if right then rectfill(x+14,y,x+15,y+11,th.side) end
 pset(x+2,y+3,th.snow and SNOW.snow or 6)
 pset(x+13,y+3,th.snow and SNOW.snow or 6)
end

function draw_bamboo(bx,base,seed)
 srand(seed)
 local n=3+flr(rnd(3))
 for i=1,n do
  local x=bx+i*5+flr(rnd(6))-6
  local h=34+flr(rnd(46))
  rectfill(x,base-h,x+1,base-1,C.bamboo2)
  pset(x,base-h,C.bamboo)
  for k=1,flr(h/8) do
   local ny=base-k*8
   line(x-2,ny,x+3,ny,C.bamboo2)
   pset(x+1,ny,C.bamboo)
  end
  if rnd(1)<0.8 then
   line(x+1,base-h+4,x+8,base-h+1,C.bamboo)
   line(x+1,base-h+7,x-6,base-h+4,C.bamboo)
  end
 end
end

function draw_pine(bx,base,seed,snow)
 srand(seed)
 local h=26+flr(rnd(38))
 local trunk=snow and SNOW.rock2 or 20
 local branch=snow and SNOW.near or C.near
 local tip=snow and SNOW.snow or C.bamboo2
 rectfill(bx-1,base-h+10,bx+1,base-1,trunk)
 for k=0,3 do
  local yy=base-h+10+k*flr(h/5)
  local w=3+k*3
  line(bx-w,yy,bx+w,yy,branch)
  line(bx-w+1,yy+1,bx+w-1,yy+1,snow and SNOW.rock or C.bamboo2)
  if snow then
   line(bx-w+1,yy-1,bx+w-1,yy-1,SNOW.snow)
   pset(bx-2,yy-1,SNOW.snow)
   pset(bx+2,yy-1,SNOW.snow)
  else
   line(bx-w+1,yy-1,bx+w-1,yy-1,C.bamboo)
  end
 end
 line(bx,base-h,bx,base-h+10,tip)
 if snow then pset(bx,base-h-1,SNOW.snow) end
end

function build_hudbar()
 local ud=userdata("u8",SW,16)
 usetarget(ud)
 cls(0)
 rectfill(0,0,SW-1,11,0)
 dither(0,12,SW-1,13,0,0)
 dither(0,14,SW-1,15,0,1)
 usetarget(nil)
 return ud
end

function build_level(map,th)
 local ud=userdata("u8",WW,WH)
 usetarget(ud)
 cls(0)
 for ty=0,MH-1 do
  for tx=0,MW-1 do
   local c=tileat_map(map,tx,ty)
   local x,y=tx*TW,ty*TW
   if c=="#" then draw_earth(x,y,tx,ty,map,th)
   elseif c=="%" then draw_rock(x,y,tx,ty,map,th)
   elseif c=="=" then draw_plank(x,y,tx,ty,map,th) end
  end
 end
 if th.snow then
  -- pinheiros nevados
  srand(77)
  for i=1,18 do
   local tx=flr(rnd(MW))
   if tileat_map(map,tx,14)=="#" and not solid_at_map(map,tx,13) then
    draw_pine(tx*TW+flr(rnd(10)),224,i*31,true)
   end
  end
  -- acumulos e cristais de gelo no chao
  srand(88)
  for tx=0,MW-1 do
   if tileat_map(map,tx,14)=="#" then
    if rnd(1)<0.5 then
     local x=tx*TW+flr(rnd(14))
     rectfill(x,222,x+2,224,SNOW.snow)
     pset(x+1,221,SNOW.snow2)
    end
    if rnd(1)<0.25 then
     local x=tx*TW+flr(rnd(14))
     line(x,223,x,220,SNOW.ice)
     pset(x+1,220,SNOW.snow)
    end
   end
  end
 else
  -- bambuzais de fundo
  srand(9)
  for i=1,14 do
   local tx=flr(rnd(MW))
   if tileat_map(map,tx,14)=="#" and not solid_at_map(map,tx,13) and not solid_at_map(map,tx,12) then
    draw_bamboo(tx*TW+flr(rnd(8)),224,i*17)
   end
  end
  -- tufos e pedrinhas no chao
  srand(55)
  for tx=0,MW-1 do
   if tileat_map(map,tx,14)=="#" then
    for k=1,2 do
     if rnd(1)<0.5 then
      local x=tx*TW+flr(rnd(14))
      line(x,223,x,221,C.grass2)
      pset(x+1,221,C.grass)
     end
    end
   end
  end
 end
 usetarget(nil)
 return ud
end

-- ============================================================
-- personagens
-- ============================================================
function draw_ninja(x,y,d,run,air,dash)
 local function nx(a) if d>0 then return x+a else return x+9-a end end
 local function rr(a,ay,b,by,c)
  local x0,x1=nx(a),nx(b)
  if x0>x1 then x0,x1=x1,x0 end
  rectfill(x0,y+ay,x1,y+by,c)
 end
 -- sombra
 if not air then ovalfill(x-1,y+17,x+10,y+18,21) end
 -- cachecol
 local bx=d>0 and x-1 or x+10
 for i=0,6 do
  local sx=bx-d*i*2
  local sy=y+2+flr(sin(frame*0.05+i*0.17)*2)+i
  local c=(i<2) and 8 or ((i<4) and 25 or 24)
  local x0,x1=sx,sx+1
  if x0>x1 then x0,x1=x1,x0 end
  rectfill(x0,sy,x1,sy+1,c)
 end
 -- pernas
 if air then
  rr(2,14,4,17,1)
  rr(5,15,7,17,1)
  rr(1,17,4,17,5)
  rr(5,17,8,17,5)
 elseif run>0 then
  if run==1 then
   rr(1,14,3,17,1)
   rr(6,14,8,16,1)
   rr(0,17,3,17,5)
   rr(6,17,9,17,5)
  else
   rr(2,14,4,16,1)
   rr(5,14,7,17,1)
   rr(2,17,5,17,5)
   rr(6,17,9,17,5)
  end
 else
  rr(2,14,4,17,1)
  rr(5,14,7,17,1)
  rr(1,17,5,17,5)
  rr(5,17,9,17,5)
 end
 -- corpo
 rr(1,7,8,13,1)
 rr(1,7,1,10,13)
 rr(8,7,8,11,12)
 -- faixa no peito
 line(nx(2),y+8,nx(7),y+10,8)
 line(nx(2),y+9,nx(7),y+11,24)
 -- faixa da cintura
 rr(1,12,8,12,8)
 rr(4,12,5,12,10)
 rr(0,13,1,15,25)
 -- bolsa de shuriken
 pset(nx(7),y+12,6)
 -- braco
 rr(7,8,9,10,1)
 rr(8,11,9,11,15)
 -- cabeca
 rr(0,0,6,6,1)
 rr(1,0,8,1,1)
 rr(2,0,6,0,13)
 rr(0,2,1,3,8)
 rr(-2,3,-1,5,8)
 -- faixa da testa
 rr(3,1,9,2,8)
 rr(3,2,9,2,24)
 -- rosto
 rr(4,3,9,4,15)
 rr(4,5,9,6,21)
 -- olho
 rectfill(nx(6),y+3,nx(6)+1,y+4,7)
 pset(nx(7),y+3,0)
 -- ponta do capuz
 pset(nx(1),y+1,13)
 if dash then
  rr(3,8,9,8,12)
  pset(nx(9),y+9,25)
 end
end
function draw_enemy(e)
 local snow=curlevel==2
 local c_tail=snow and SNOW.snow2 or 21
 local c_body=snow and SNOW.ice2 or 2
 local c_hi=snow and SNOW.snow or 18
 local c_dark=snow and SNOW.rock or 2
 local c_horn=snow and SNOW.snow or 6
 local c_eye=snow and SNOW.ice or 25
 local c_pupil=snow and SNOW.rock2 or 10
 local x=flr(e.x)
 local y=flr(e.y)+flr(sin(frame*0.07+e.x*0.09)*1.5)
 -- cauda espectral
 for i=0,2 do
  local w=6-i*2
  local yy=y+12+i*2
  rectfill(x+8-w,yy,x+7+w,yy+1,c_tail)
  if i==0 then pset(x+5,yy,c_body) pset(x+10,yy,c_body) end
 end
 -- corpo
 ovalfill(x+1,y+1,x+14,y+12,c_body)
 ovalfill(x+2,y+2,x+13,y+7,c_hi)
 ovalfill(x+3,y+3,x+12,y+6,c_dark)
 -- chifres
 line(x+2,y+2,x,y-2,c_horn)
 line(x+3,y+1,x+1,y-2,c_horn)
 line(x+13,y+2,x+15,y-2,c_horn)
 line(x+12,y+1,x+14,y-2,c_horn)
 -- olhos
 local blink=((frame+flr(e.x))%113)>105
 circfill(x+5,y+6,2,c_eye)
 circfill(x+10,y+6,2,c_eye)
 if not blink then
  pset(x+5,y+6,c_pupil) pset(x+10,y+6,c_pupil)
  pset(x+5,y+6,7) pset(x+10,y+6,7)
 end
 -- boca
 rectfill(x+6,y+10,x+9,y+10,snow and SNOW.ice or 24)
 pset(x+5,y+10,c_tail) pset(x+10,y+10,c_tail)
 pset(x+1,y+8,c_tail) pset(x+14,y+8,c_tail)
end

function draw_scroll(s)
 local bob=sin(frame*0.045+s.id)*2
 local x=flr(s.x)
 local y=flr(s.y+bob)
 -- aura
 if (frame\4+s.id)%2==0 then
  circ(x,y,14,35)
  circ(x,y,11,10)
 end
 for i=0,3 do
  local a=frame*0.03+s.id*0.6+i*0.25
  pset(flr(x+cos(a)*10),flr(y+sin(a)*10),(i%2==0) and 7 or 10)
 end
 -- corpo de papel
 rectfill(x-5,y-4,x+4,y+4,7)
 rectfill(x-5,y+3,x+4,y+4,6)
 -- suporte e bordas enroladas
 rectfill(x-7,y-6,x+6,y-5,4)
 rectfill(x-7,y+4,x+6,y+5,4)
 rectfill(x-7,y-5,x-6,y+4,9)
 rectfill(x+5,y-5,x+6,y+4,9)
 rectfill(x-7,y-5,x-7,y+4,25)
 rectfill(x+6,y-5,x+6,y+4,25)
 -- tinta
 line(x-4,y-1,x+2,y-1,21)
 line(x-4,y+1,x+2,y+1,21)
 pset(x+2,y+1,8)
 rectfill(x-4,y+2,x-3,y+3,8)
 -- brilho
 pset(x-6,y-6,7)
 pset(x+5,y+5,7)
end
function draw_shuri(s)
 local x=flr(s.x)+3
 local y=flr(s.y)+3
 local a=s.t*0.3
 for i=0,3 do
  local aa=a+i*0.25
  line(x,y,x+cos(aa)*4,y+sin(aa)*4,7)
  pset(x+cos(aa)*4,y+sin(aa)*4,6)
 end
 pset(x,y,7)
 pset(x-sgn(s.vx)*5,y,6)
end

function draw_parts()
 for q in all(parts) do
  local x=flr(q.x)
  local y=flr(q.y)
  if q.big then
   rectfill(x,y,x+1,y+1,q.c)
  else
   pset(x,y,q.c)
  end
  if q.glow then pset(x+1,y,q.c) end
 end
end

function draw_torii(cx,base)
 -- halo
 if (frame\16)%2==0 then
  circ(cx,base-34,34,35)
  circ(cx,base-34,40,34)
 end
 -- pilares
 rectfill(cx-29,base-62,cx-21,base-1,8)
 rectfill(cx-29,base-62,cx-29,base-1,24)
 rectfill(cx-25,base-62,cx-24,base-1,25)
 rectfill(cx+20,base-62,cx+28,base-1,8)
 rectfill(cx+28,base-62,cx+28,base-1,24)
 rectfill(cx+22,base-62,cx+23,base-1,25)
 -- bases de pedra
 rectfill(cx-32,base-3,cx-18,base-1,5)
 rectfill(cx+17,base-3,cx+31,base-1,5)
 line(cx-32,base-3,cx-18,base-3,6)
 line(cx+17,base-3,cx+31,base-3,6)
 -- viga superior
 rectfill(cx-40,base-66,cx+40,base-60,8)
 rectfill(cx-40,base-66,cx+40,base-65,25)
 rectfill(cx-40,base-61,cx+40,base-60,24)
 line(cx-42,base-66,cx+42,base-66,21)
 line(cx-42,base-66,cx-44,base-68,21)
 line(cx+42,base-66,cx+44,base-68,21)
 -- segunda viga
 rectfill(cx-31,base-52,cx+31,base-49,8)
 rectfill(cx-31,base-52,cx+31,base-52,24)
 rectfill(cx-31,base-49,cx+31,base-49,25)
 -- placa
 rectfill(cx-9,base-62,cx+9,base-53,21)
 line(cx-9,base-62,cx+9,base-62,10)
 line(cx-9,base-53,cx+9,base-53,10)
 line(cx-9,base-62,cx-9,base-53,10)
 line(cx+9,base-62,cx+9,base-53,10)
 line(cx-3,base-60,cx-3,base-55,10)
 line(cx-3,base-60,cx+3,base-55,10)
 line(cx+3,base-60,cx+3,base-55,10)
 -- corda sagrada
 for i=-26,26,4 do
  line(cx+i,base-47,cx+i+2,base-45,7)
  line(cx+i+2,base-45,cx+i+4,base-47,7)
 end
 line(cx-5,base-47,cx-5,base-42,7)
 line(cx+5,base-47,cx+5,base-42,7)
 pset(cx-5,base-41,7) pset(cx+5,base-41,7)
 -- reflexo
 dither(cx-34,base-8,cx+34,base-2,25,0)
end

function draw_snow_torii(cx,base)
 -- halo gelado
 if (frame\16)%2==0 then
  circ(cx,base-34,36,SNOW.ice2)
  circ(cx,base-34,42,SNOW.ice)
 end
 -- pilares
 rectfill(cx-29,base-62,cx-21,base-1,SNOW.ice2)
 rectfill(cx-29,base-62,cx-29,base-1,SNOW.rock)
 rectfill(cx-25,base-62,cx-24,base-1,SNOW.snow2)
 rectfill(cx+20,base-62,cx+28,base-1,SNOW.ice2)
 rectfill(cx+28,base-62,cx+28,base-1,SNOW.rock)
 rectfill(cx+22,base-62,cx+23,base-1,SNOW.snow2)
 -- bases de pedra
 rectfill(cx-32,base-3,cx-18,base-1,SNOW.rock)
 rectfill(cx+17,base-3,cx+31,base-1,SNOW.rock)
 line(cx-32,base-3,cx-18,base-3,SNOW.snow)
 line(cx+17,base-3,cx+31,base-3,SNOW.snow)
 -- viga superior
 rectfill(cx-40,base-66,cx+40,base-60,SNOW.ice2)
 rectfill(cx-40,base-66,cx+40,base-65,SNOW.snow)
 rectfill(cx-40,base-61,cx+40,base-60,SNOW.rock)
 line(cx-42,base-66,cx+42,base-66,SNOW.snow2)
 line(cx-42,base-66,cx-44,base-68,SNOW.snow2)
 line(cx+42,base-66,cx+44,base-68,SNOW.snow2)
 -- segunda viga
 rectfill(cx-31,base-52,cx+31,base-49,SNOW.ice2)
 rectfill(cx-31,base-52,cx+31,base-52,SNOW.snow)
 rectfill(cx-31,base-49,cx+31,base-49,SNOW.rock)
 -- placa
 rectfill(cx-9,base-62,cx+9,base-53,SNOW.rock)
 line(cx-9,base-62,cx+9,base-62,SNOW.snow2)
 line(cx-9,base-53,cx+9,base-53,SNOW.snow2)
 line(cx-9,base-62,cx-9,base-53,SNOW.snow2)
 line(cx+9,base-62,cx+9,base-53,SNOW.snow2)
 line(cx-3,base-60,cx-3,base-55,SNOW.ice)
 line(cx-3,base-60,cx+3,base-55,SNOW.ice)
 line(cx+3,base-60,cx+3,base-55,SNOW.ice)
 -- corda sagrada
 for i=-26,26,4 do
  line(cx+i,base-47,cx+i+2,base-45,SNOW.snow)
  line(cx+i+2,base-45,cx+i+4,base-47,SNOW.snow)
 end
 line(cx-5,base-47,cx-5,base-42,SNOW.snow)
 line(cx+5,base-47,cx+5,base-42,SNOW.snow)
 pset(cx-5,base-41,SNOW.snow) pset(cx+5,base-41,SNOW.snow)
 -- pingentes de gelo
 for i=-30,30,10 do
  local h=3+((i+30)\10)%3
  line(cx+i,base-60,cx+i,base-60+h,SNOW.snow2)
  pset(cx+i,base-60+h,SNOW.snow)
 end
 -- neve acumulada e reflexo
 dither(cx-38,base-67,cx+38,base-64,SNOW.snow,0)
 dither(cx-34,base-8,cx+34,base-2,SNOW.snow2,0)
end

function draw_lantern(cx,base,lit)
 rectfill(cx-7,base-3,cx+7,base-1,45)
 line(cx-7,base-3,cx+7,base-3,5)
 rectfill(cx-3,base-11,cx+3,base-4,46)
 rectfill(cx-3,base-11,cx-3,base-4,45)
 rectfill(cx-6,base-19,cx+6,base-12,45)
 rectfill(cx-5,base-18,cx+5,base-13,lit and 10 or 21)
 rectfill(cx-8,base-22,cx+8,base-20,5)
 line(cx-9,base-22,cx+9,base-22,6)
 pset(cx,base-23,6)
 rectfill(cx-9,base-19,cx+9,base-19,46)
 if lit then
  pset(cx,base-16,25)
  pset(cx,base-15,10)
  pset(cx-1,base-14,9)
  pset(cx+1,base-14,9)
  circ(cx,base-16,7,9)
  circ(cx,base-16,12,25)
  dither(cx-9,base-24,cx+9,base-8,9,1)
  pset(cx-3,base-16,9) pset(cx+3,base-16,9)
 else
  pset(cx-2,base-16,5)
 end
end

function draw_snow_lantern(cx,base,lit)
 rectfill(cx-7,base-3,cx+7,base-1,SNOW.rock)
 line(cx-7,base-3,cx+7,base-3,SNOW.rock2)
 rectfill(cx-3,base-11,cx+3,base-4,SNOW.rock2)
 rectfill(cx-3,base-11,cx-3,base-4,SNOW.rock)
 rectfill(cx-6,base-19,cx+6,base-12,SNOW.rock)
 rectfill(cx-5,base-18,cx+5,base-13,lit and SNOW.warm or SNOW.rock2)
 rectfill(cx-8,base-22,cx+8,base-20,SNOW.rock2)
 line(cx-9,base-22,cx+9,base-22,SNOW.rock)
 pset(cx,base-23,SNOW.rock)
 rectfill(cx-9,base-19,cx+9,base-19,SNOW.rock)
 -- neve acumulada no topo
 rectfill(cx-8,base-22,cx+8,base-21,SNOW.snow)
 pset(cx-9,base-21,SNOW.snow2) pset(cx+9,base-21,SNOW.snow2)
 if lit then
  pset(cx,base-16,SNOW.snow)
  pset(cx,base-15,SNOW.warm)
  pset(cx-1,base-14,SNOW.warm)
  pset(cx+1,base-14,SNOW.warm)
  circ(cx,base-16,7,SNOW.warm)
  circ(cx,base-16,12,SNOW.ice)
  dither(cx-9,base-24,cx+9,base-8,SNOW.warm,1)
  pset(cx-3,base-16,SNOW.warm) pset(cx+3,base-16,SNOW.warm)
 else
  pset(cx-2,base-16,SNOW.rock2)
 end
end

-- ============================================================
-- estado do jogo
-- ============================================================
function newrun()
 score=0
 lives=3
 cleared={false,false}
 unlocked=1
 curlevel=1
 curmap=level
 cam=0
 check=24
 shake=0
 prompt=0
 tt=0
 parts={}
 shuris={}
 enemies={}
 scrolls={}
 flies={}
 leaves={}
 flakes={}
 mapd=0
 mapface=1
 mapwalk=0
 mapnear=nil
 mapx,mapy=map_path_at(0)
 mapcam=mid(0,mapx-SW/2,MAPW-SW)
 state="map"
 stop_music()
 music_on=true
 mtempo=14
 mtick=0
 mstep=0
 poke(0x5538,muted and 0 or 0x40)
 poke(0x5539,muted and 0 or 0x40)
 say("SETAS ANDAR   X ENTRAR",180)
end

function enter_level(id,silent)
 curlevel=id
 local cfg=LEVELS[id]
 curmap=cfg.map
 lives=3
 cam=0
 check=24
 shake=0
 prompt=0
 tt=0
 mapnear=nil
 p={x=cfg.startx,y=cfg.starty,vx=0,vy=0,face=1,ground=false,inv=0,
    coyote=0,jumps=0,jbuf=0,s1=false,s2=false,dash=0,dashcd=0,
    shoot=0,anim=0,ltap=-99,rtap=-99}
 scrolls=copy_scrolls(cfg.scrolls)
 enemies=copy_enemies(cfg.enemies)
 shuris={}
 parts={}
 flies={}
 leaves={}
 flakes={}
 if id==1 then
  srand(4242)
  for i=1,16 do
   add(flies,{x=rnd(WW),y=200+rnd(60),p=rnd(1),s=0.2+rnd(.3)})
  end
  for i=1,10 do
   add(leaves,{x=rnd(WW),y=rnd(WH),s=0.3+rnd(.5),p=rnd(1)})
  end
 else
  srand(5151)
  for i=1,110 do
   add(flakes,{x=rnd(WW),y=rnd(WH),s=0.3+rnd(.8),p=rnd(1)})
  end
 end
 state="play"
 music_on=true
 mtempo=cfg.tempo
 mtick=0
 mstep=0
 poke(0x5538,muted and 0 or 0x40)
 poke(0x5539,muted and 0 or 0x40)
 say(cfg.name,180)
 if not silent then playsfx("enter") end
end

function to_map(kind)
 state="map"
 lives=3
 shake=0
 prompt=0
 tt=0
 parts={}
 shuris={}
 flies={}
 leaves={}
 flakes={}
 mapd=MAPNODES[curlevel].d
 mapx,mapy=map_path_at(mapd)
 mapface=1
 mapwalk=0
 mapcam=mid(0,mapx-SW/2,MAPW-SW)
 mapnear=MAPNODES[curlevel]
 stop_music()
 music_on=true
 mtempo=14
 mtick=0
 poke(0x5538,muted and 0 or 0x40)
 poke(0x5539,muted and 0 or 0x40)
 if kind=="win" then
  cleared[curlevel]=true
  if curlevel==1 then unlocked=2 end
  if cleared[1] and cleared[2] then
   say("JOGO COMPLETO!",240)
  else
   say("FASE CONCLUIDA",180)
  end
 else
  say("DE VOLTA AO MAPA",180)
 end
end

function newgame(silent)
 score=0
 lives=3
 cleared={false,false}
 unlocked=1
 curlevel=1
 curmap=level
 cam=0
 check=24
 shake=0
 prompt=0
 tt=0
 enter_level(1,silent)
end

function say(s,t)
 toast=s
 tt=t or 150
end

function startdash(d)
 p.face=d
 p.dash=8
 p.dashcd=30
 p.vy=0
 playsfx("dash")
 burst(p.x+5,p.y+9,8,12)
end

function burst(x,y,n,c)
 for i=1,n do
  add(parts,{x=x,y=y,vx=(rnd(2)-1)*1.8,vy=-rnd(2.2),
   life=10+rnd(16),c=c,big=(rnd(1)<.4)})
 end
end

function update_player()
 p.inv=max(0,p.inv-1)
 p.dashcd=max(0,p.dashcd-1)
 p.shoot=max(0,p.shoot-1)
 p.anim+=1
 local dir=(down(1) and 1 or 0)-(down(0) and 1 or 0)
 local jp=pressed(5)
 local fp=pressed(4)
 if jp then p.jbuf=6 end

 -- dash: duplo toque na direcao, depois do pergaminho 1
 if p.s1 then
  if pressed(0) then
   if frame-p.ltap<18 and p.dashcd<=0 then startdash(-1) end
   p.ltap=frame
  elseif pressed(1) then
   if frame-p.rtap<18 and p.dashcd<=0 then startdash(1) end
   p.rtap=frame
  end
 end

 if p.dash>0 then
  p.dash-=1
  p.vx=p.face*6.4
  p.vy=0
  if frame%3==0 then
   add(parts,{x=p.x+5,y=p.y+9,vx=-p.face*1.2,vy=(rnd(2)-1)*.6,
    life=12,c=12,big=true})
  end
 else
  local acc=p.s1 and .30 or .16
  local fr=p.s1 and .78 or .90
  if dir~=0 then
   p.vx+=dir*acc
   p.face=dir
  else
   p.vx*=fr
   if abs(p.vx)<.02 then p.vx=0 end
  end
  local mx=p.s1 and 2.8 or 2.0
  p.vx=mid(-mx,p.vx,mx)
 end

 if p.ground then p.coyote=4 p.jumps=0 end
 if p.jbuf>0 then
  if p.ground or p.coyote>0 then
   p.vy=JUMP
   p.ground=false
   p.dash=0
   p.coyote=0
   p.jumps=1
   p.jbuf=0
   playsfx("jump")
  elseif p.s2 and p.jumps<2 then
   p.vy=JUMP*.92
   p.jumps=2
   p.dash=0
   p.jbuf=0
   playsfx("djump")
   burst(p.x+5,p.y+PHF,10,12)
  end
 end
 if p.jbuf>0 then p.jbuf-=1 end
 if p.coyote>0 then p.coyote-=1 end
 if p.dash<=0 then p.vy=min(p.vy+GRAV,8) end

 -- eixo X
 if abs(p.vx)>0 then
  p.x+=p.vx
  if hit(p.x,p.y,PWF,PHF) then
   if p.vx>0 then
    p.x=flr((p.x+PWF)/TW)*TW-PWF
   else
    p.x=(flr(p.x/TW)+1)*TW
   end
   local s=sgn(p.vx)
   while hit(p.x,p.y,PWF,PHF) do p.x-=s*.25 end
   p.vx=0
   if p.dash>0 then p.dash=0 end
  end
 end
 -- eixo Y
 p.ground=false
 if abs(p.vy)>0 then
  p.y+=p.vy
  if hit(p.x,p.y,PWF,PHF) then
   if p.vy>0 then
    p.y=flr((p.y+PHF)/TW)*TW-PHF
    p.ground=true
   else
    p.y=(flr(p.y/TW)+1)*TW
   end
   local s=sgn(p.vy)
   while hit(p.x,p.y,PWF,PHF) do p.y-=s*.25 end
   p.vy=0
  end
 end
 if p.dash>0 and hit(p.x,p.y+1,PWF,PHF) then p.ground=true end

 -- checkpoint
 local cfg=LEVELS[curlevel]
 if p.ground and p.x>cfg.check_x and check<cfg.check_x then
  check=cfg.check_spawn
  playsfx("check")
  if tt<=0 then say("CHECKPOINT",90) end
 end

 if fp and p.shoot<=0 then
  add(shuris,{x=p.x+(p.face>0 and 9 or -3),y=p.y+4,
   vx=p.face*6,life=60,t=0})
  playsfx("shuri")
  p.shoot=6
  p.anim=0
 end
 if p.y>300 then lose_life() end
end

function update_scrolls()
 for s in all(scrolls) do
  if not s.got then
   if p.x+PWF>s.x-6 and p.x<s.x+5 and p.y+PHF>s.y-6 and p.y<s.y+5 then
    s.got=true
    score+=250
    playsfx("scroll")
    burst(s.x,s.y,20,10)
    if s.id==1 then
     p.s1=true
     say("DASH: 2X ESQUERDA/DIREITA",210)
    else
     p.s2=true
     say("PULO DUPLO: X NO AR",210)
    end
   end
  end
 end
end

function update_enemies()
 for e in all(enemies) do
  if not e.dead then
   e.x+=e.dir*e.spd
   if e.x<e.x1 then e.x=e.x1 e.dir=1 end
   if e.x>e.x2 then e.x=e.x2 e.dir=-1 end
   e.anim+=1
   if p.inv<=0 and p.x+PWF>e.x+1 and p.x<e.x+15 and
      p.y+PHF>e.y+1 and p.y<e.y+13 then
    hurt(e)
   end
  end
 end
end

function hurt(e)
 if p.inv>0 then return end
 lives-=1
 p.inv=90
 p.dash=0
 shake=8
 local d=sgn((p.x+5)-(e.x+8))
 if d==0 then d=-p.face end
 p.vx=d*4.2
 p.vy=-2.8
 burst(p.x+5,p.y+9,12,8)
 if lives<=0 then
  state="over"
  stop_music()
  playsfx("over")
  tt=0
 else
  playsfx("hurt")
  say("CUIDADO!",80)
 end
end

function lose_life()
 lives-=1
 if lives<=0 then
  state="over"
  stop_music()
  playsfx("over")
  tt=0
 else
  playsfx("hurt")
  p.x=check
  p.y=190
  p.vx=0
  p.vy=0
  p.dash=0
  p.inv=90
  p.ground=false
  shake=6
  burst(p.x+5,p.y+9,10,12)
  say("TENTE DE NOVO",80)
 end
end

function update_shuris()
 for i=#shuris,1,-1 do
  local s=shuris[i]
  s.x+=s.vx
  s.t+=1
  s.life-=1
  local dead=s.life<=0 or s.x<-8 or s.x>WW+8
  if not dead then
   if solid_at(flr((s.x+3)/TW),flr((s.y+3)/TW)) then
    dead=true
   else
    for j=1,#enemies do
     local e=enemies[j]
     if not e.dead and s.x+6>e.x and s.x<e.x+16 and s.y+6>e.y and s.y<e.y+14 then
      e.dead=true
      score+=200
      playsfx("kill")
      burst(e.x+8,e.y+7,16,9)
      dead=true
      break
     end
    end
   end
  end
  if dead then
   burst(s.x+3,s.y+3,5,6)
   deli(shuris,i)
  end
 end
end

function update_parts()
 for i=#parts,1,-1 do
  local q=parts[i]
  q.x+=q.vx
  q.y+=q.vy
  q.vy+=.22
  q.life-=1
  if q.life<=0 or q.y>WH+20 then deli(parts,i) end
 end
 if #parts>170 then
  for i=1,#parts-170 do deli(parts,1) end
 end
end

function update_ambient()
 for f in all(flies) do
  f.p+=0.01*f.s
  f.x+=cos(f.p+frame*0.01)*0.15
  f.y+=sin(f.p*1.7)*0.18
  if f.x<0 then f.x+=WW elseif f.x>WW then f.x-=WW end
 end
 for l in all(leaves) do
  l.p+=0.01*l.s
  l.x+=sin(l.p*2)*0.6-0.2
  l.y+=0.25+l.s*0.2
  if l.y>WH-30 then l.y=-5 l.x=rnd(WW) end
 end
 for f in all(flakes) do
  f.p+=0.015
  f.x+=0.15+sin(f.p*2)*0.45
  f.y+=0.35+f.s
  if f.y>WH then f.y=-4 f.x=rnd(WW) end
  if f.x<0 then f.x+=WW elseif f.x>WW then f.x-=WW end
 end
end

function update_map()
 local dir=(down(1) and 1 or 0)-(down(0) and 1 or 0)
 if dir~=0 then
  mapd=mid(0,mapd+dir*1.25,MAPLEN)
  mapface=dir
  mapwalk+=1
 else
  mapwalk=0
 end
 mapx,mapy=map_path_at(mapd)
 local target=mid(0,mapx-SW/2,MAPW-SW)
 mapcam+=(target-mapcam)*.15
 if abs(mapcam-target)<.2 then mapcam=target end
 mapnear=nil
 for n in all(MAPNODES) do
  if abs(mapd-n.d)<16 then mapnear=n end
 end
 if pressed(5) or pressed(4) then
  if mapnear then
   if mapnear.id<=unlocked then
    enter_level(mapnear.id)
   else
    say("BLOQUEADO: VENCA O TEMPLO",120)
    playsfx("deny")
   end
  else
   say("VA ATE UMA FASE",90)
  end
 end
end

function _update()
 frame+=1
 update_sfx()
 update_music()
 if shake>0 then shake-=1 end

 if state=="title" then
  update_parts()
  update_ambient()
  if pressed(5) or pressed(4) then
   newrun()
   playsfx("start")
  end
  input_end()
  return
 end

 if state=="map" then
  if tt>0 then tt-=1 end
  if prompt>0 then prompt-=1 end
  update_map()
  update_parts()
  update_ambient()
  input_end()
  return
 end

 if tt>0 then tt-=1 end
 if prompt>0 then prompt-=1 end

 if state~="play" then
  if pressed(5) or pressed(4) then
   to_map(state=="win" and "win" or "over")
  end
  update_parts()
  update_ambient()
  input_end()
  return
 end

 update_player()
 if state=="play" then
  update_scrolls()
  update_enemies()
  if state=="play" then
   update_shuris()
   local cfg=LEVELS[curlevel]
   if p.ground and p.x>cfg.goal_x and p.y<cfg.goal_y then
    if p.s1 and p.s2 then
     state="win"
     score+=1000
     stop_music()
     playsfx("win")
     tt=0
     burst(p.x+5,p.y,40,10)
    elseif prompt<=0 then
     local falta=0
     if not p.s1 then falta+=1 end
     if not p.s2 then falta+=1 end
     say("FALTA "..falta..(falta==1 and " PERGAMINHO" or " PERGAMINHOS"),120)
     prompt=150
    end
   end
  end
 end

 local target=mid(0,p.x+5-200,WW-SW)
 cam+=(target-cam)*.12
 if abs(cam-target)<.2 then cam=target end

 update_parts()
 update_ambient()
 input_end()
end

-- ============================================================
-- desenho
-- ============================================================
function draw_bg(cx)
 blit(sky,get_draw_target(),0,0,0,0,SW,SH)
 -- estrelas piscando
 for i=1,9 do
  local sx=(i*53+17)%SW
  local sy=(i*31+9)%140
  if ((frame\8)+i)%5~=0 then pset(sx,sy,(i%3==0) and 7 or 6) end
 end
 -- nuvens
 for c in all(clouds) do
  local x=(c.x-cx*0.08+frame*c.spd)%760-80
  spr(c.ud,flr(x),c.y)
 end
 sspr(far,flr(cx*.12),0,SW,170,0,100,SW,170)
 sspr(near,flr(cx*.35),0,SW,130,0,140,SW,130)
end

function draw_snow_bg(cx)
 blit(snowsky,get_draw_target(),0,0,0,0,SW,SH)
 for i=1,9 do
  local sx=(i*53+17)%SW
  local sy=(i*31+9)%140
  if ((frame\8)+i)%5~=0 then pset(sx,sy,(i%3==0) and SNOW.snow or SNOW.snow2) end
 end
 for c in all(snowclouds) do
  local x=(c.x-cx*0.08+frame*c.spd)%760-80
  spr(c.ud,flr(x),c.y)
 end
 sspr(snowfar,flr(cx*.12),0,SW,170,0,100,SW,170)
 sspr(snownear,flr(cx*.35),0,SW,130,0,140,SW,130)
end

-- fundo do titulo
function draw_title_scene()
 draw_bg(0)
 -- chao
 rectfill(0,224,SW-1,SH-1,39)
 rectfill(0,224,SW-1,226,C.grass2)
 for x=0,SW-1 do
  if (x*3)%13<5 then line(x,224,x,220+((x*7)%3),C.grass2) end
 end
 for i=0,8 do
  local x=18+i*54+((i*17)%11)
  rectfill(x,222,x+5,224,C.stone2)
  pset(x+1,221,C.stone)
  pset(x+4,222,C.stone)
 end
 draw_bamboo(18,224,71)
 draw_bamboo(452,224,72)
 draw_torii(402,224)
 draw_ninja(300,206,-1,0,false,false)
 -- vagalumes
 for f in all(flies) do
  local sx=flr(f.x%SW)
  local sy=200+flr(f.y%40)
  if (frame+f.p*20)%7<4 then
   pset(sx,sy,26)
   pset(sx+1,sy,42)
  end
 end
 -- titulo
 bigtext_shadow("NINJA",50,40,6,10)
 smalltext_shadow("PERGAMINHOS",50,100,5,8)
 print("PICOTRON EDITION",54,134,22)
 if (frame\20)%2==0 then pset(54,132,7) pset(286,132,7) end
 -- comecar
 if (frame\26)%2==0 then
  ctext("X PARA COMECAR",152,10)
 else
  ctext("X PARA COMECAR",152,7)
 end
 ctext("SETAS MOVER    X PULO    Z SHURIKEN",174,7)
 ctext("M LIGA/DESLIGA O SOM",184,6)
 -- rodape
 ptext("SCOGAMES 2026",SW-96,SH-12,6)
end

-- ============================================================
-- mapa de fases (overworld)
-- ============================================================
function draw_map_flag(x,y,c)
 line(x,y,x,y-22,9)
 pset(x,y-23,10)
 line(x,y-22,x+12,y-18,c)
 line(x,y-18,x+12,y-18,c)
 line(x,y-22,x,y-18,c)
 pset(x+12,y-18,c)
end

function draw_map_lock(x,y)
 circ(x,y-2,4,10)
 rectfill(x-5,y+1,x+5,y+9,10)
 rectfill(x-4,y+2,x+4,y+8,9)
 pset(x,y+4,0)
 line(x,y+5,x,y+6,0)
end

function build_map()
 local ud=userdata("u8",MAPW,MAPH)
 usetarget(ud)
 cls(C.sky0)
 -- ceu em bandas
 local bands={
  {0,70,C.sky0},{70,130,C.sky1},{130,180,C.sky2},
  {180,215,C.sky3},{215,MAPH,C.sky4},
 }
 for b in all(bands) do rectfill(0,b[1],MAPW-1,b[2]-1,b[3]) end
 for i=1,#bands-1 do
  local y=bands[i][2]
  for yy=y-4,y-1 do
   local t=(yy-(y-4))/4
   for x=0,MAPW-1 do
    if rnd(1)<t then pset(x,yy,bands[i+1][3]) else pset(x,yy,bands[i][3]) end
   end
  end
 end
 -- estrelas
 srand(900)
 for i=1,190 do
  local x=flr(rnd(MAPW))
  local y=flr(rnd(180))
  local dx=x-760
  local dy=y-62
  if dx*dx+dy*dy>34*34 then
   local r=rnd(1)
   pset(x,y,(r<0.55) and 6 or ((r<0.85) and 7 or C.sky3))
   if r>0.94 then pset(x+1,y,6) end
  end
 end
 -- lua
 local mx,my,mr=760,62,26
 srand(901)
 for i=1,900 do
  local a=rnd(1)
  local rr=mr+2+rnd(1)*30
  local x=flr(mx+cos(a)*rr)
  local y=flr(my+sin(a)*rr)
  if rnd(1)<(1-(rr-mr)/32)*0.65 then
   pset(x,y,(i%4==0) and C.sky3 or C.sky4)
  end
 end
 circfill(mx,my,mr,C.moon)
 dither(mx-15,my+5,mx-6,my+13,6,0)
 dither(mx+3,my-12,mx+11,my-5,6,1)
 dither(mx+7,my+8,mx+14,my+14,C.sky4,0)
 -- montanhas distantes
 srand(902)
 local function fy(x) return flr(150+sin(x/200)*20+sin(x/67+0.8)*8+sin(x/23+1.1)*3) end
 for x=0,MAPW-1 do
  local y=fy(x)
  line(x,y,x,230,C.far)
  pset(x,y,C.sky3)
  if y<130 then pset(x,y+1,C.sky3) end
 end
 -- pico nevado a direita
 for x=660,MAPW-1 do
  local t=abs(x-850)/210
  local y=flr(220-130*(1-t))
  if y<82 then y=82 end
  if y<220 then
   line(x,y,x,229,SNOW.far)
   if y<150 then
    pset(x,y,SNOW.snow)
    if (x+y)%3==0 then pset(x,y+1,SNOW.snow2) end
   else
    pset(x,y,SNOW.near)
   end
  end
 end
 -- colinas proximas
 srand(903)
 local function ny(x) return flr(190+sin(x/150+0.7)*14+sin(x/53+2)*6) end
 for x=0,MAPW-1 do
  line(x,ny(x),x,229,C.near)
  pset(x,ny(x),C.far)
 end
 -- terreno sob a trilha
 for x=0,MAPW-1 do
  local py=flr(MAPPATHY[x] or 214)
  local top=py+6
  local c1,c2,edge
  if x>700 then
   c1,c2,edge=SNOW.ice2,SNOW.rock,SNOW.snow
  elseif x>560 then
   c1,c2,edge=C.grass2,SNOW.rock,SNOW.snow2
  else
   c1,c2,edge=C.grass2,C.grass,C.grass
  end
  if x>408 and x<492 then
   line(x,top,x,MAPH-1,0)
   line(x,top,x,top+10,21)
  else
   line(x,top,x,MAPH-1,c1)
   line(x,top+8,x,MAPH-1,c2)
   pset(x,top,edge)
   pset(x,top+1,edge)
   if x%3==0 then pset(x,top+2,c1) end
   if x%5==0 then pset(x,top+3+((x*7)%14),c2) end
  end
 end
 -- arvores atras da trilha
 srand(904)
 for i=1,34 do
  local x=flr(rnd(MAPW))
  local py=flr(MAPPATHY[x] or 214)
  if abs(x-48)>42 and abs(x-300)>52 and abs(x-880)>62 then
   if x<560 then
    draw_bamboo(x,py+12,i*23)
   else
    draw_pine(x,py+12,i*29,true)
   end
  end
 end
 -- trilha: borda escura, corpo de terra e centro claro
 for i=1,#MAPSEG do
  local s=MAPSEG[i]
  line(s.x,s.y-4,s.x+s.dx,s.y+s.dy-4,21)
  line(s.x,s.y+4,s.x+s.dx,s.y+s.dy+4,21)
  line(s.x,s.y-3,s.x+s.dx,s.y+s.dy-3,4)
  line(s.x,s.y+3,s.x+s.dx,s.y+s.dy+3,4)
  line(s.x,s.y-1,s.x+s.dx,s.y+s.dy-1,9)
  line(s.x,s.y+1,s.x+s.dx,s.y+s.dy+1,9)
  line(s.x,s.y,s.x+s.dx,s.y+s.dy,10)
 end
 -- marcas da trilha
 for d=0,MAPLEN,18 do
  local x,y=map_path_at(d)
  pset(flr(x),flr(y),9)
 end
 -- ponte sobre o desfiladeiro
 for x=410,488,8 do
  local y=flr(path_y_at_x(x))
  rectfill(x,y-5,x+5,y+1,4)
  line(x,y-5,x+5,y-5,9)
  line(x,y+1,x+5,y+1,20)
  pset(x+2,y-2,10)
 end
 local ry1=flr(path_y_at_x(408))-14
 local ry2=flr(path_y_at_x(492))-14
 line(408,ry1,492,ry2,9)
 for x=408,492,21 do
  local y=flr(path_y_at_x(x))
  line(x,y-14,x,y-5,9)
  pset(x,y-15,10)
 end
 -- detalhes do chao
 srand(905)
 for i=1,130 do
  local x=flr(rnd(MAPW))
  local py=flr(MAPPATHY[x] or 214)
  local yy=py+12+flr(rnd(46))
  if x<560 then
   if rnd(1)<0.55 then
    line(x,yy,x,yy-2-flr(rnd(2)),C.grass2)
    pset(x+1,yy-2,C.grass)
   else
    rectfill(x,yy,x+1,yy+1,C.stone2)
    pset(x,yy,C.stone)
   end
  else
   pset(x,yy,SNOW.snow2)
   if rnd(1)<0.3 then pset(x+1,yy,SNOW.ice) end
  end
 end
 usetarget(nil)
 return ud
end

function draw_map_house(x,base)
 -- sombra
 ovalfill(x-28,base-3,x+28,base+2,0)
 -- corpo
 rectfill(x-24,base-30,x+24,base-2,8)
 rectfill(x-24,base-30,x+24,base-4,24)
 for y=base-28,base-6,6 do line(x-22,y,x+22,y,20) end
 -- telhado
 for i=0,24 do
  line(x-30+i,base-30-i,x+30-i,base-30-i,8)
  line(x-30+i,base-29-i,x+30-i,base-29-i,24)
 end
 line(x-30,base-30,x,base-54,8)
 line(x+30,base-30,x,base-54,8)
 -- porta
 rectfill(x-7,base-18,x+7,base-2,4)
 rectfill(x-5,base-16,x+5,base-2,20)
 pset(x-2,base-9,10) pset(x+2,base-9,10)
 -- janela
 rectfill(x-19,base-22,x-11,base-14,9)
 line(x-19,base-18,x-11,base-18,10)
 pset(x-18,base-21,7)
 -- chamine
 rectfill(x+12,base-52,x+19,base-38,21)
 rectfill(x+12,base-52,x+19,base-50,6)
 -- fumaca
 for i=0,5 do
  local a=frame*0.02+i*0.3
  local yy=base-58-i*7-((frame*0.5+i*9)%7)
  local xx=x+15+sin(a)*4
  circfill(flr(xx),yy,2+(i%2),(i%2==0) and 21 or 6)
 end
end

function draw_map_node(n,sx,base)
 local done=cleared[n.id]
 local locked=n.id>unlocked
 local flagc=done and C.grass or (locked and 5 or 8)
 if n.id==1 then
  if (frame\16)%2==0 then circ(sx,base-28,30,35) end
  pagoda(sx,base-2,44,8,25)
  rectfill(sx-7,base-16,sx+7,base-2,21)
  rectfill(sx-5,base-14,sx+5,base-2,9)
  line(sx-5,base-2,sx+5,base-2,10)
  rectfill(sx-10,base-2,sx+10,base+2,5)
  line(sx-10,base-2,sx+10,base-2,6)
  draw_map_flag(sx+24,base-8,flagc)
 else
  -- pico de neve
  for y=base-72,base do
   local ww=flr((y-(base-72))*0.62)
   line(sx-ww,y,sx+ww,y,SNOW.far)
  end
  for y=base-72,base-52 do
   local ww=flr((y-(base-72))*0.62)
   line(sx-ww,y,sx+ww,y,SNOW.snow)
  end
  -- portal de gelo
  rectfill(sx-20,base-40,sx-14,base-2,SNOW.ice2)
  rectfill(sx+14,base-40,sx+20,base-2,SNOW.ice2)
  rectfill(sx-24,base-44,sx+24,base-38,SNOW.ice)
  rectfill(sx-24,base-44,sx+24,base-43,SNOW.snow)
  rectfill(sx-10,base-32,sx+10,base-2,0)
  rectfill(sx-8,base-30,sx+8,base-2,SNOW.ice2)
  rectfill(sx-6,base-28,sx+6,base-2,SNOW.ice)
  -- pingentes
  for i=-20,20,10 do
   line(sx+i,base-38,sx+i,base-34,SNOW.snow)
  end
  draw_map_flag(sx+26,base-10,flagc)
 end
 if locked then draw_map_lock(sx,base-58) end
 -- marcador numerado
 circfill(sx,base+10,8,0)
 circ(sx,base+10,8,done and C.grass or 10)
 smalltext(tostr(n.id),sx-2,base+6,1,done and C.grass or 10)
end

function draw_map()
 local cx=flr(mapcam)
 blit(mapbmp,get_draw_target(),cx,0,0,0,SW,SH)
 -- nuvens
 for c in all(clouds) do
  local x=(c.x-cx*0.12+frame*c.spd)%(MAPW+180)-90
  spr(c.ud,flr(x),c.y)
 end
 -- casa inicial
 draw_map_house(48-cx,214)
 -- nos de fase
 for n in all(MAPNODES) do
  local sx=n.x-cx
  if sx>-100 and sx<SW+100 then draw_map_node(n,sx,n.y) end
 end
 -- estrela de jogo completo
 if cleared[1] and cleared[2] then
  local sx=MAPNODES[2].x-cx
  local sy=MAPNODES[2].y-88
  if sx>-20 and sx<SW+20 then
   line(sx-8,sy,sx+8,sy,10)
   line(sx-8,sy,sx-12,sy-8,10)
   line(sx,sy,sx,sy-11,10)
   line(sx+8,sy,sx+12,sy-8,10)
   pset(sx,sy-12,7)
  end
 end
 -- ninja
 local px=mapx-cx
 local run=(mapwalk>0) and (flr(mapwalk/5)%2+1) or 0
 draw_ninja(flr(px)-5,flr(mapy)-18,mapface,run,false,false)
 -- painel do no proximo
 if mapnear then
  local n=mapnear
  local nm=LEVELS[n.id].name
  local ok=n.id<=unlocked
  local l2=ok and "X ENTRAR" or "BLOQUEADO"
  local w=max(#nm,#l2)*5+18
  local x=mid(8,flr(n.x-cx-w/2),SW-w-8)
  local y=mid(24,flr(n.y)-98,SH-58)
  draw_panel(x,y,x+w,y+32,ok and 10 or 8)
  ptext(nm,x+9,y+6,ok and 10 or 6)
  ptext(l2,x+9,y+18,ok and 7 or 8)
 end
 -- HUD
 blit(hudbar,get_draw_target(),0,0,0,0,SW,16)
 for i=1,3 do draw_mask(8+(i-1)*10,3,i<=lives) end
 ptext("MAPA",flr((SW-4*5)/2),3,10)
 local s="PONTOS "..string.format("%06d",score)
 ptext(s,SW-10-#s*5,3,10)
 local nc=(cleared[1] and 1 or 0)+(cleared[2] and 1 or 0)
 ptext("FASES "..nc.."/2",42,3,7)
 local hint="SETAS ANDAR   X ENTRAR"
 ptext(hint,flr((SW-#hint*5)/2),SH-12,7)
 if tt>0 then
  local w=#toast*5+14
  local x=flr((SW-w)/2)
  rectfill(x,22,x+w,33,0)
  rect(x,22,x+w,33,9)
  pset(x,22,7) pset(x+w,33,7)
  ptext(toast,x+7,25,7)
 end
 if muted then ptext("MUDO",8,SH-12,6) end
end

function draw_world()
 local cx=flr(cam)
 if shake>0 then cx+=flr(sin(frame*1.9)*shake) end
 cx=mid(0,cx,WW-SW)
 local snow=curlevel==2
 local cfg=LEVELS[curlevel]
 if snow then draw_snow_bg(cx) else draw_bg(cx) end
 sspr(snow and snowbmp or levelbmp,cx,0,SW,SH,0,0,SW,SH)
 camera(cx,0)
 if snow then
  draw_snow_lantern(cfg.check_spawn-6,224,check>cfg.check_x)
  draw_snow_torii(cfg.torii_x,112)
 else
  draw_lantern(cfg.check_spawn-6,224,check>cfg.check_x)
  draw_torii(cfg.torii_x,112)
 end
 for s in all(scrolls) do
  if not s.got then draw_scroll(s) end
 end
 for e in all(enemies) do
  if not e.dead then draw_enemy(e) end
 end
 for s in all(shuris) do draw_shuri(s) end
 draw_parts()
 if not snow then
  -- vagalumes
  for f in all(flies) do
   if f.x>cx-8 and f.x<cx+SW+8 then
    local sx=flr(f.x-cx)
    local sy=flr(f.y)
    local tw=(frame*0.07+f.p)%1
    if tw<0.55 then
     pset(sx,sy,(tw<0.25) and 26 or 10)
     pset(sx+1,sy,C.grass2)
    end
   end
  end
  -- folhas
  for l in all(leaves) do
   if l.x>cx-4 and l.x<cx+SW+4 then
    pset(flr(l.x-cx),flr(l.y),C.bamboo)
    if l.s>0.5 then pset(flr(l.x-cx)+1,flr(l.y),C.bamboo2) end
   end
  end
 end
 if not (p.inv>0 and (frame\4)%2==0) then
  draw_ninja(flr(p.x),flr(p.y),p.face,
   (p.ground and abs(p.vx)>.2) and (flr(p.anim/5)%2+1) or 0,
   not p.ground, p.dash>0)
 end
 if snow then
  -- nevasca em primeiro plano
  for f in all(flakes) do
   if f.x>cx-4 and f.x<cx+SW+4 then
    local sx=flr(f.x-cx)
    local sy=flr(f.y)
    pset(sx,sy,(f.s>0.9) and SNOW.snow or SNOW.snow2)
    if f.s>1.15 then pset(sx+1,sy,SNOW.ice) end
   end
  end
 end
 camera()
end

function draw_mask(x,y,on)
 local c=on and 7 or 5
 rectfill(x+1,y,x+5,y,c)
 rectfill(x,y+1,x+6,y+3,c)
 pset(x+2,y+2,on and 0 or 4)
 pset(x+4,y+2,on and 0 or 4)
 pset(x+1,y+1,on and 8 or 5)
 pset(x+5,y+1,on and 8 or 5)
 pset(x+2,y+4,on and 8 or 4)
 pset(x+3,y+5,on and 8 or 4)
 pset(x+4,y+4,on and 8 or 4)
end

function draw_scroll_icon(x,y,on)
 local paper=on and 7 or 5
 local roll=on and 9 or 4
 rectfill(x+1,y+1,x+7,y+8,paper)
 rectfill(x,y,x+1,y+9,roll)
 rectfill(x+7,y,x+8,y+9,roll)
 if on then
  line(x+3,y+4,x+6,y+4,21)
  line(x+3,y+6,x+6,y+6,21)
  pset(x+7,y+2,25)
 else
  line(x+3,y+5,x+6,y+5,4)
 end
end
function draw_hud()
 -- barra
 blit(hudbar,get_draw_target(),0,0,0,0,SW,16)
 for i=1,3 do
  draw_mask(8+(i-1)*10,3,i<=lives)
 end
 local s="PONTOS "..string.format("%06d",score)
 ptext(s,flr((SW-#s*5)/2),3,10)
 draw_scroll_icon(436,3,p.s1)
 draw_scroll_icon(452,3,p.s2)
 if tt>0 then
  local w=#toast*5+14
  local x=flr((SW-w)/2)
  rectfill(x,22,x+w,33,0)
  rect(x,22,x+w,33,9)
  pset(x,22,7) pset(x+w,33,7)
  ptext(toast,x+7,25,7)
 end
 if muted then
  ptext("MUDO",8,SH-12,6)
 end
end
function draw_panel(x0,y0,x1,y1,c)
 rectfill(x0,y0,x1,y1,0)
 rect(x0,y0,x1,y1,c)
 rect(x0+2,y0+2,x1-2,y1-2,33)
 pset(x0,y0,7) pset(x1,y0,7) pset(x0,y1,7) pset(x1,y1,7)
end

function draw_overlay()
 if state=="win" then
  draw_panel(108,62,372,198,10)
  ctext("FASE CONCLUIDA",74,10)
  ctext(LEVELS[curlevel].name,88,7)
  ctext("PONTOS "..score,102,7)
  ctext("PERGAMINHOS 2/2",116,C.grass)
  draw_scroll_icon(222,130,true)
  draw_scroll_icon(240,130,true)
  ctext("OBRIGADO POR JOGAR",148,6)
  if (frame\26)%2==0 then ctext("X VOLTA AO MAPA",164,7) end
  if frame%9==0 then
   burst(110+rnd(270),70+rnd(60),10,(rnd(1)<.5) and 10 or 25)
  end
 elseif state=="over" then
  draw_panel(120,74,360,196,8)
  ctext("GAME OVER",88,8)
  ctext(LEVELS[curlevel].name,104,6)
  ctext("PONTOS "..score,118,7)
  local n=(p.s1 and 1 or 0)+(p.s2 and 1 or 0)
  ctext("PERGAMINHOS "..n.."/2",132,6)
  if (frame\26)%2==0 then ctext("X VOLTA AO MAPA",152,6) end
 end
end
function _draw()
 if state=="title" then
  draw_title_scene()
  return
 end
 if state=="map" then
  draw_map()
  return
 end
 draw_world()
 draw_hud()
 draw_overlay()
 if shake>3 then
  rect(0,0,SW-1,SH-1,8)
  rect(1,1,SW-2,SH-2,8)
  if shake>6 then rect(2,2,SW-3,SH-3,24) end
 end
end

-- ============================================================
-- boot
-- ============================================================
function _init()
 poke(0x5f5c,255)
 poke(0x5f5d,255)
 set_palette()
 init_audio()
 build_mappath()
 srand(7)
 sky=build_sky()
 far=build_far()
 near=build_near()
 levelbmp=build_level(level,THEMES.forest)
 snowbmp=build_level(snowlevel,THEMES.snow)
 snowsky=build_snow_sky()
 snowfar=build_snow_far()
 snownear=build_snow_near()
 hudbar=build_hudbar()
 clouds={}
 for i=1,4 do
  add(clouds,{ud=build_cloud(),x=i*180+rnd(90),y=88+rnd(58),spd=0.06+rnd(.08)})
 end
 snowclouds={}
 for i=1,4 do
  add(snowclouds,{ud=build_snow_cloud(),x=i*180+rnd(90),y=88+rnd(58),spd=0.06+rnd(.08)})
 end
 mapbmp=build_map()
 newgame(true)
 state="title"
 stop_music()
 music_on=true
end

:: [eoc]
